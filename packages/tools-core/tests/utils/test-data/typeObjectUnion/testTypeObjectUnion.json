{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schema.twindev.org/test/TypeObjectUnion",
	"description": "A simple object union type alias.",
	"title": "TypeObjectUnion",
	"anyOf": [
		{
			"type": "object",
			"properties": {
				"foo": {
					"type": "string"
				}
			},
			"required": ["foo"]
		},
		{
			"type": "object",
			"properties": {
				"bar": {
					"type": "number"
				}
			},
			"required": ["bar"]
		}
	]
}
