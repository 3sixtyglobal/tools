{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schema.3sixty.global/test/DoubleInheritanceC",
	"title": "DoubleInheritanceC",
	"description": "Derived interface that omits prop1 from B (which extends A).",
	"type": "object",
	"properties": {
		"@id": {
			"type": "string",
			"description": "Unique identifier for the offer."
		}
	},
	"required": ["@id"],
	"allOf": [
		{
			"$comment": "Inlined utility base type DoubleInheritanceB so utility transformations can operate on concrete properties instead of a $ref.",
			"description": "Intermediate interface extending A.",
			"type": "object",
			"properties": {
				"@type": {
					"$comment": "Inherited from DoubleInheritanceB",
					"const": "Offer",
					"description": "The type must be \"Offer\"."
				},
				"profile": {
					"$comment": "Inherited from DoubleInheritanceA",
					"anyOf": [
						{
							"type": "string"
						},
						{
							"type": "array",
							"items": {
								"type": "string"
							}
						}
					],
					"description": "The profile(s) this policy conforms to."
				},
				"assigner": {
					"$comment": "Inherited from DoubleInheritanceB",
					"anyOf": [
						{
							"type": "string"
						},
						{
							"type": "array",
							"items": {
								"type": "string"
							}
						}
					],
					"description": "The assigner of the offer."
				}
			},
			"required": ["@type", "assigner"]
		}
	]
}
