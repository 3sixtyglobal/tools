		"anyValue": {
			"description": "A value typed as any."
		},
		"neverValue": {
			"description": "A value typed as never.",
			"not": {}
		},
		"@context": {
			"type": "string",
			"description": "A field name that is a reserved keyword in JSON Schema, requiring special handling."
		}
	},
	"required": [
		"stringValue",
		"booleanValue",
		"numberValue",
		"arrayValue",
		"objectValue",
		"anyValue",
		"neverValue",
		"@context"
