{
	"name": "@twin.org/ts-to-schema",
	"version": "0.0.2-next.9",
	"description": "Tool to convert TypeScript definitions to JSON schemas",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/twinfoundation/tools.git",
		"directory": "apps/ts-to-schema"
	},
	"author": "martyn.janes@iota.org",
	"license": "Apache-2.0",
	"type": "module",
	"engines": {
		"node": ">=20.0.0"
	},
	"scripts": {
		"clean": "rimraf dist coverage",
		"build": "tsc",
		"dev": "nodemon --watch src --ext ts --exec \"npm run build && npm run bundle:esm\"",
		"merge-locales": "merge-locales",
		"test": "vitest --run --config ./vitest.config.ts --no-cache",
		"test:build": "tsc -p ./tests/tsconfig.json --noEmit",
		"coverage": "vitest --run --coverage --config ./vitest.config.ts --no-cache",
		"bundle:esm": "rollup --config rollup.config.mjs --environment MODULE:esm",
		"bundle:cjs": "rollup --config rollup.config.mjs --environment MODULE:cjs",
		"bundle": "npm run bundle:esm && npm run bundle:cjs",
		"docs:clean": "rimraf docs/reference",
		"docs:generate": "typedoc",
		"docs": "npm run docs:clean && npm run docs:generate",
		"dist": "npm run clean && npm run build && npm run merge-locales && npm run test:build && npm run test && npm run bundle && npm run docs",
		"dist:no-test": "npm run clean && npm run build && npm run merge-locales && npm run bundle && npm run docs",
		"prepare": "ts-patch install -s"
	},
	"dependencies": {
		"@twin.org/cli-core": "next",
		"@twin.org/core": "next",
		"@twin.org/nameof": "next",
		"@twin.org/tools-core": "0.0.2-next.9",
		"commander": "14.0.1",
		"glob": "11.0.3",
		"ts-json-schema-generator": "2.4.0"
	},
	"devDependencies": {
		"@twin.org/merge-locales": "next",
		"@twin.org/nameof-transformer": "next",
		"@twin.org/nameof-vitest-plugin": "next",
		"@types/node": "24.5.2",
		"@vitest/coverage-v8": "3.2.4",
		"copyfiles": "2.4.1",
		"nodemon": "3.1.10",
		"rimraf": "6.0.1",
		"rollup": "4.52.3",
		"ts-patch": "3.3.0",
		"typedoc": "0.28.13",
		"typedoc-plugin-markdown": "4.9.0",
		"typescript": "5.9.2",
		"vitest": "3.2.4"
	},
	"main": "./dist/cjs/index.cjs",
	"module": "./dist/esm/index.mjs",
	"types": "./dist/types/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"require": "./dist/cjs/index.cjs",
			"import": "./dist/esm/index.mjs"
		}
	},
	"files": [
		"bin",
		"dist/cjs",
		"dist/esm",
		"dist/locales",
		"dist/types",
		"locales",
		"docs"
	],
	"bin": {
		"ts-to-schema": "bin/index.js"
	}
}
