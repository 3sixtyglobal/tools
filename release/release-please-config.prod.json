{
	"$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
	"description": "Auto-Generated Release Please configuration for prod",
	"pull-request-title-pattern": "chore: prod release prepared",
	"pull-request-header": "chore: prod release prepared",
	"pull-request-footer": "This PR was generated by the Release Production GHA",
	"release-type": "node",
	"initial-version": "0.0.1",
	"versioning": "default",
	"packages": {
		"packages/tools-models": {
			"package-name": "tools-models",
			"changelog-path": "docs/changelog.md"
		},
		"packages/tools-core": {
			"package-name": "tools-core",
			"changelog-path": "docs/changelog.md"
		},
		"apps/ts-to-openapi": {
			"package-name": "ts-to-openapi",
			"changelog-path": "docs/changelog.md",
			"extra-files": [
				"src/cli.ts"
			]
		},
		"apps/ts-to-schema": {
			"package-name": "ts-to-schema",
			"changelog-path": "docs/changelog.md",
			"extra-files": [
				"src/cli.ts"
			]
		},
		"apps/ts-to-jsonld-context": {
			"package-name": "ts-to-jsonld-context",
			"changelog-path": "docs/changelog.md",
			"extra-files": [
				"src/cli.ts"
			]
		}
	},
	"plugins": [
		"node-workspace",
		{
			"type": "linked-versions",
			"groupName": "repo",
			"components": [
				"tools-models",
				"tools-core",
				"ts-to-openapi",
				"ts-to-schema",
				"ts-to-jsonld-context"
			]
		}
	]
}
